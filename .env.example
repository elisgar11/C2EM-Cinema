SECRET_KEY=replace-with-a-long-random-value
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Europe/Madrid
CSRF_TRUSTED_ORIGINS=

# Vercel: add Postgres in Storage tab (injects DATABASE_URL).
# Vercel: add Blob store in Storage tab (injects BLOB_READ_WRITE_TOKEN / BLOB_STORE_ID).
# Vercel auto-adds VERCEL_URL / VERCEL_PROJECT_PRODUCTION_URL for ALLOWED_HOSTS.
# Set SECRET_KEY, DEBUG=false, and a strong DEFAULT_ADMIN_PASSWORD in the dashboard.
# With Blob connected, posters and backdrops persist via Vercel Blob storage.

DEFAULT_ADMIN_ENABLED=true
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin
DEFAULT_ADMIN_EMAIL=admin@localhost

MOVIE_METADATA_PROVIDER=tmdb
MOVIE_METADATA_FALLBACK_PROVIDER=wikidata
MOVIE_METADATA_AUTO_FETCH=true
MOVIE_METADATA_FETCH_IMAGES=true
MOVIE_METADATA_IMAGE_TIMEOUT_SECONDS=8
MOVIE_METADATA_IMAGE_MAX_BYTES=15728640
TMDB_API_TOKEN=
TMDB_LANGUAGE=es-ES
TMDB_FALLBACK_LANGUAGE=en-US
TMDB_TIMEOUT_SECONDS=8
TMDB_MAX_CAST_MEMBERS=12
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
TMDB_POSTER_PREVIEW_SIZE=w342
TMDB_POSTER_SIZE=w780
TMDB_BACKDROP_SIZE=w1280
WIKIDATA_ENABLED=true
WIKIDATA_LANGUAGE=es
WIKIDATA_FALLBACK_LANGUAGE=en
WIKIDATA_TIMEOUT_SECONDS=8
WIKIDATA_MAX_CAST_MEMBERS=12
WIKIDATA_POSTER_PREVIEW_WIDTH=342
WIKIDATA_POSTER_WIDTH=780
WIKIDATA_USER_AGENT=C2EM-Cinema/1.0
